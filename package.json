{
  "name": "helpdesk-badge-app",
  "version": "1.0.0",
  "description": "Help Desk Employee Badge Generator",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "test": "bun test tests/api/ tests/db/ tests/unit/",
    "test:api": "bun test tests/api/",
    "test:db": "bun test tests/db/",
    "test:e2e": "bunx playwright test",
    "lint": "bash scripts/lint.sh",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "bun test tests/unit/"
  },
  "dependencies": {
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "hono": "^4.13.20",
    "playwright": "^1.62.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
